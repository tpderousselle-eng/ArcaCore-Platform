# syntax=docker/dockerfile:1

FROM python:{{ python_version }}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system arcacore \
    && adduser --system --ingroup arcacore arcacore

COPY {{ requirements }} /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY --chown=arcacore:arcacore {{ source }} ./{{ source }}

USER arcacore

EXPOSE {{ port }}

CMD ["python", "-m", "uvicorn", "{{ app }}", "--host", "0.0.0.0", "--port", "{{ port }}"]
