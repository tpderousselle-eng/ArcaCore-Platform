name: {{ project_name }}

services:
  api:
    build:
      context: .
      dockerfile: {{ dockerfile }}
    restart: unless-stopped
    env_file:
      - {{ env_file }}
    environment:
      DATABASE_URL: "postgresql+psycopg2://${POSTGRES_USER:-arcacore}:${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in the env file}@postgres:5432/${POSTGRES_DB:-arcacore}"
    ports:
      - "{{ api_port }}:{{ container_port }}"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ container_port }}/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
    depends_on:
      postgres:
        condition: service_healthy

  postgres:
    image: {{ database_image }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: "${POSTGRES_USER:-arcacore}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in the env file}"
      POSTGRES_DB: "${POSTGRES_DB:-arcacore}"
    ports:
      - "{{ database_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 10s
      timeout: 5s
      start_period: 10s
      retries: 5
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
