{% if has_uuid %}
import uuid

{% endif %}
{% if has_enum %}
from enum import Enum

{% endif %}
from sqlalchemy import (
    Boolean,
    Column,
    Date,
    DateTime,
    Float,
    ForeignKey,
    Integer,
{% if has_numeric %}
    Numeric,
{% endif %}
{% if has_json %}
    JSON,
{% endif %}
    String,
    Text,
{% if has_uuid %}
    UUID,
{% endif %}
{% if has_enum %}
    Enum as SQLEnum,
{% endif %}
    func,
)

{% if has_relationships %}
from sqlalchemy.orm import relationship

{% endif %}
from backend.app.db.base import Base

{% if has_enum %}
{% for enum_name, enum_values in enums %}
class {{ enum_name }}(str, Enum):
{% for value in enum_values %}
    {{ value.upper().replace(" ", "_") }} = "{{ value }}"
{% endfor %}

{% endfor %}
{% endif %}

class {{ class_name }}(Base):
    __tablename__ = "{{ table_name }}"

{% if not has_primary_key %}
    id = Column(
        Integer,
        primary_key=True,
        index=True,
    )

{% endif %}
{% for field in fields %}
    {{ field.name }} = Column(
{% for argument in field.arguments %}
{% if "Enum(" in argument %}
        {{ argument.replace("Enum(", "SQLEnum(") }},
{% else %}
        {{ argument }},
{% endif %}
{% endfor %}
{% if field.sqlalchemy_type == "UUID" and field.primary_key %}
        default=uuid.uuid4,
{% endif %}
    )

{% endfor %}
{% for field in fields %}
{% if field.relationship_arguments %}
    {{ field.relationship_name }} = relationship(
{% for argument in field.relationship_arguments %}
        {{ argument }},
{% endfor %}
    )

{% endif %}
{% endfor %}
    created_at = Column(
        DateTime(timezone=True),
        server_default=func.now(),
    )

    updated_at = Column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
    )