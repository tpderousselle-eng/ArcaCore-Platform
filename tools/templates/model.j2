{% if has_uuid %}
import uuid

{% endif %}
{% if has_enum %}
from enum import Enum

{% endif %}
from sqlalchemy import (
{% if has_array %}
    ARRAY,
{% endif %}
    Boolean,
{% if check_constraints %}
    CheckConstraint,
{% endif %}
    Column,
    Date,
    DateTime,
    Float,
    ForeignKey,
{% if indexes %}
    Index,
{% endif %}
    Integer,
{% if has_numeric %}
    Numeric,
{% endif %}
{% if has_json %}
    JSON,
{% endif %}
    String,
{% if associations %}
    Table,
{% endif %}
    Text,
{% if unique_constraints %}
    UniqueConstraint,
{% endif %}
{% if has_uuid %}
    UUID,
{% endif %}
{% if has_enum or has_choice %}
    Enum as SQLEnum,
{% endif %}
    func,
)

{% if has_relationships %}
from sqlalchemy.orm import relationship
{% if has_one_to_one %}
from sqlalchemy.orm import backref
{% endif %}

{% endif %}
from backend.app.db.base import Base

{% for association in associations %}
{{ association.name }} = Table(
    "{{ association.name }}",
    Base.metadata,
    Column("source_id", ForeignKey("{{ association.source_reference }}"), primary_key=True),
    Column("target_id", ForeignKey("{{ association.target_reference }}"), primary_key=True),
)

{% endfor %}
{% if has_enum %}
{% for enum_name, enum_values in enums %}
class {{ enum_name }}(str, Enum):
{% for value in enum_values %}
    {{ value.upper().replace(" ", "_") }} = "{{ value }}"
{% endfor %}

{% endfor %}
{% endif %}

class {{ class_name }}(Base):
    __tablename__ = "{{ table_name }}"

{% if indexes or unique_constraints or check_constraints %}
    __table_args__ = (
{% for index in indexes %}
        {{ index }},
{% endfor %}
{% for constraint in unique_constraints %}
        {{ constraint }},
{% endfor %}
{% for constraint in check_constraints %}
        {{ constraint }},
{% endfor %}
    )

{% endif %}
{% if not has_primary_key %}
    id = Column(
        Integer,
        primary_key=True,
        index=True,
    )

{% endif %}
{% for field in fields %}
{% if field.arguments %}
    {{ field.name }} = Column(
{% for argument in field.arguments %}
{% if argument.startswith("Enum(") %}
        {{ argument.replace("Enum(", "SQLEnum(", 1) }},
{% else %}
        {{ argument }},
{% endif %}
{% endfor %}
{% if field.sqlalchemy_type == "UUID" and field.primary_key %}
        default=uuid.uuid4,
{% endif %}
    )

{% endif %}
{% endfor %}
{% for field in fields %}
{% if field.relationship_arguments %}
    {{ field.relationship_name }} = relationship(
{% for argument in field.relationship_arguments %}
        {{ argument }},
{% endfor %}
    )

{% endif %}
{% endfor %}
{% if soft_delete %}
    deleted_at = Column(
        DateTime(timezone=True),
        nullable=True,
        index=True,
    )

{% endif %}
    created_at = Column(
        DateTime(timezone=True),
        server_default=func.now(),
    )

    updated_at = Column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
    )
