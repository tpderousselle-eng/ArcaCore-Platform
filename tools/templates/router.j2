from uuid import UUID

{% endif %}
from fastapi import APIRouter, Depends, HTTPException, Request, Response, status
from sqlalchemy.orm import Session

from backend.app.db.session import get_db
from backend.app.schemas.{{ module }} import (
    {{ class_name }}Create,
    {{ class_name }}Response,
    {{ class_name }}Update,
)
from backend.app.services.{{ module }} import {{ class_name }}Service


router = APIRouter(
    prefix="/{{ module }}s",
    tags=["{{ class_name }}"],
)


def _authorized_principal(request: Request, required_scope: str):
    """Consume identity established by trusted application authentication middleware."""

    principal_id = getattr(request.state, "arcacore_principal_id", None)
    raw_scopes = getattr(request.state, "arcacore_scopes", ())
    if principal_id is None:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Authentication required.")
    if isinstance(raw_scopes, str):
        scopes = frozenset(raw_scopes.split())
    else:
        try:
            scopes = frozenset(raw_scopes)
        except TypeError:
            scopes = frozenset()
    if required_scope not in scopes and "{{ module }}:*" not in scopes:
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Insufficient scope.")
    return principal_id


def _require_read_access(request: Request):
    return _authorized_principal(request, "{{ module }}:read")


def _require_write_access(request: Request){% if audit_fields %} -> {{ actor_type }}{% endif %}:
    principal_id = _authorized_principal(request, "{{ module }}:write")
{% if audit_fields %}
    try:
        return {{ actor_type }}(principal_id)
    except (TypeError, ValueError) as error:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Authenticated principal has an invalid identifier.",
        ) from error
{% else %}
    return principal_id
{% endif %}


@router.post("", response_model={{ class_name }}Response, status_code=status.HTTP_201_CREATED)
def create_{{ module }}(
    payload: {{ class_name }}Create,{% if audit_fields %}
    actor_id: {{ actor_type }} = Depends(_require_write_access),{% else %}
    _principal=Depends(_require_write_access),{% endif %}
    db: Session = Depends(get_db),
):
    service = {{ class_name }}Service(db)
    return service.create(
        payload.model_dump(exclude_unset=True){% if audit_fields %}, actor_id{% endif %}
    )


@router.get("", response_model=list[{{ class_name }}Response])
def list_{{ module }}s(
    _principal=Depends(_require_read_access),
    db: Session = Depends(get_db),
):
    return {{ class_name }}Service(db).list()


@router.get("/{item_id}", response_model={{ class_name }}Response)
def get_{{ module }}(
    item_id: {{ primary_key_type }},
    _principal=Depends(_require_read_access),
    db: Session = Depends(get_db),
):
    item = {{ class_name }}Service(db).get(item_id)
    if item is None:
        raise HTTPException(status_code=404, detail="{{ class_name }} not found.")
    return item


@router.patch("/{item_id}", response_model={{ class_name }}Response)
def update_{{ module }}(
    item_id: {{ primary_key_type }},
    payload: {{ class_name }}Update,{% if audit_fields %}
    actor_id: {{ actor_type }} = Depends(_require_write_access),{% else %}
    _principal=Depends(_require_write_access),{% endif %}
    db: Session = Depends(get_db),
):
    service = {{ class_name }}Service(db)
    item = service.update(
        item_id,
        payload.model_dump(exclude_unset=True){% if audit_fields %},
        actor_id{% endif %},
    )
    if item is None:
        raise HTTPException(status_code=404, detail="{{ class_name }} not found.")
    return item


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_{{ module }}(
    item_id: {{ primary_key_type }},{% if audit_fields %}
    actor_id: {{ actor_type }} = Depends(_require_write_access),{% else %}
    _principal=Depends(_require_write_access),{% endif %}
    db: Session = Depends(get_db),
):
    service = {{ class_name }}Service(db)
{% if soft_delete %}
    item = service.delete(item_id{% if audit_fields %}, actor_id{% endif %})
{% else %}
    item = service.remove(item_id)
{% endif %}
    if item is None:
        raise HTTPException(status_code=404, detail="{{ class_name }} not found.")
    return Response(status_code=status.HTTP_204_NO_CONTENT)
{% if soft_delete %}


@router.post("/{item_id}/restore", response_model={{ class_name }}Response)
def restore_{{ module }}(
    item_id: {{ primary_key_type }},{% if audit_fields %}
    actor_id: {{ actor_type }} = Depends(_require_write_access),{% else %}
    _principal=Depends(_require_write_access),{% endif %}
    db: Session = Depends(get_db),
):
    item = {{ class_name }}Service(db).restore(
        item_id{% if audit_fields %}, actor_id{% endif %}
    )
    if item is None:
        raise HTTPException(status_code=404, detail="{{ class_name }} not found.")
    return item
{% endif %}
