from backend.app.crud.{{ module }} import {{ class_name }}CRUD
{% for relationship in tenant_relationships if not relationship.self %}
from backend.app.models.{{ relationship.module }} import {{ relationship.model }}
{% endfor %}
{% if tenant_relationships %}
from backend.app.models.{{ module }} import {{ class_name }}
{% endif %}


class {{ class_name }}Service:

    def __init__(self, db{% if policy_contract %}, trusted_roles{% endif %}):
        self.crud = {{ class_name }}CRUD(db)
{% if policy_contract %}
        if not isinstance(trusted_roles, tuple) or any(not isinstance(role, str) for role in trusted_roles):
            raise PermissionError("Trusted authorization context is required.")
        self._trusted_roles = trusted_roles

    def _authorize(self, action):
        roles = {{ policy_roles|tojson }}
        denied = frozenset({{ policy_denies|tojson }})
        if action in denied:
            raise PermissionError("Operation denied by policy.")
        permissions = set()
        for role in self._trusted_roles:
            if role not in roles:
                raise PermissionError("Unknown role denied by policy.")
            permissions.update(roles[role])
        if action not in permissions:
            raise PermissionError("Operation denied by policy.")
{% endif %}
{% if tenant_relationships %}
    def _validate_tenant_relationships(self, values, tenant_id):
        if tenant_id is None:
            raise PermissionError("Relationship target is inaccessible.")
{% for relationship in tenant_relationships %}
        if "{{ relationship.field }}" in values and values["{{ relationship.field }}"] is not None:
{% if relationship.many %}
            targets = values["{{ relationship.field }}"]
            if not isinstance(targets, (tuple, list, set, frozenset)):
                raise PermissionError("Relationship target is inaccessible.")
            if any(getattr(target, "{{ relationship.tenant_key }}", None) != tenant_id for target in targets):
                raise PermissionError("Relationship target is inaccessible.")
{% else %}
            target = self.crud.db.query({{ class_name if relationship.self else relationship.model }}).filter(
                {{ class_name if relationship.self else relationship.model }}.{{ relationship.target_key }} == values["{{ relationship.field }}"],
                {{ class_name if relationship.self else relationship.model }}.{{ relationship.tenant_key }} == tenant_id,
            ).first()
            if target is None:
                raise PermissionError("Relationship target is inaccessible.")
            if hasattr(target, "deleted_at") and target.deleted_at is not None:
                raise PermissionError("Relationship target is inaccessible.")
{% endif %}
{% endfor %}
{% endif %}

    def create(self, values: dict{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id{% endif %}):
{% if policy_contract %}        self._authorize("create")
{% endif %}
{% if tenant_relationships %}        self._validate_tenant_relationships(values, tenant_id)
{% endif %}
        return self.crud.create(values{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id{% endif %})

    def update(self, item_id, values: dict{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id{% endif %}):
{% if policy_contract %}        self._authorize("update")
{% endif %}
{% if tenant_relationships %}        self._validate_tenant_relationships(values, tenant_id)
{% endif %}
        return self.crud.update(item_id, values{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id{% endif %})

{% if soft_delete %}
    def get(self, item_id, include_deleted: bool = False{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("read")
{% endif %}
        return self.crud.get(item_id, include_deleted=include_deleted{% if tenant_contract %}, tenant_id=tenant_id{% endif %})

    def list(self, include_deleted: bool = False{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("list")
{% endif %}
        return self.crud.list(include_deleted=include_deleted{% if tenant_contract %}, tenant_id=tenant_id{% endif %})

    def delete(self, item_id{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("delete")
{% endif %}
        return self.crud.delete(item_id{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id=tenant_id{% endif %})

    def restore(self, item_id{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("restore")
{% endif %}
        return self.crud.restore(item_id{% if audit_fields %}, actor_id{% endif %}{% if tenant_contract %}, tenant_id=tenant_id{% endif %})
{% else %}
    def get(self, item_id{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("read")
{% endif %}
        return self.crud.get(item_id{% if tenant_contract %}, tenant_id=tenant_id{% endif %})

    def list(self{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("list")
{% endif %}
        return self.crud.list({% if tenant_contract %}tenant_id=tenant_id{% endif %})

    def remove(self, item_id{% if tenant_contract %}, tenant_id=None{% endif %}):
{% if policy_contract %}        self._authorize("delete")
{% endif %}
        return self.crud.remove(item_id{% if tenant_contract %}, tenant_id=tenant_id{% endif %})
{% endif %}
