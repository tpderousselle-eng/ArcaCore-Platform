def _arca_validate_slug(value):
    if not isinstance(value, str):
        raise ValueError("Slug must be a string.")
    if _re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", value) is None:
        raise ValueError(
            "Slug must contain lowercase ASCII letters or digits separated by single "
            "hyphens, without leading or trailing hyphens."
        )
    return value


_arca_SlugString = _typing.Annotated[
    str,
    _pydantic.BeforeValidator(_arca_validate_slug),
    _pydantic.Field(json_schema_extra={"format": "slug"}),
]
